[Unit]
Description=Pocket Whiteboard — tabletop role-playing games (5E)
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-whiteboard
Group=pocket-whiteboard
ExecStart=/usr/local/bin/pocket-whiteboard
Environment=DATA_DIR=/var/lib/pocket-whiteboard
Environment=PORT=8080
Environment=BASE_URL=https://forum.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-whiteboard
PrivateTmp=true

[Install]
WantedBy=multi-user.target
